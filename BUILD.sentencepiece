package(default_visibility = ["//visibility:public"])

# 系统化生成 config.h
genrule(
    name = "generate_config_h",
    outs = ["src/config.h"],
    cmd = """
cat <<EOF > $@
#ifndef CONFIG_H_
#define CONFIG_H_
#define PACKAGE_NAME "sentencepiece"
#define PACKAGE_VERSION "0.2.0"
#ifdef OS_WIN
#define HAVE_STDLIB_H 1
#endif
#endif
EOF
""",
)

proto_library(
    name = "sentencepiece_proto",
    srcs = ["src/sentencepiece.proto"],
)

cc_proto_library(
    name = "sentencepiece_cc_proto",
    deps = [":sentencepiece_proto"],
)

proto_library(
    name = "sentencepiece_model_proto",
    srcs = ["src/sentencepiece_model.proto"],
)

cc_proto_library(
    name = "sentencepiece_model_cc_proto",
    deps = [":sentencepiece_model_proto"],
)

cc_library(
    name = "sentencepiece_processor",
    srcs = glob(
        ["src/*.cc"],
        exclude = [
            "src/*_test.cc",
            "src/*_main.cc",
            "src/sentencepiece_trainer.cc",
            "src/trainer_interface.cc",
            "src/builder.cc",
            "src/error.cc",
        ],
    ),
    hdrs = glob(["src/*.h"]) + [":src/config.h"],
    copts = [
        "-DENABLE_NFKC_COMPILE",
        "-DSENTENCEPIECE_PG3_BUILD",
        "/I$(GENDIR)/external/com_google_absl",
        "/Iexternal/com_google_absl",
        "/Iexternal/com_google_protobuf/src",
        "/I$(GENDIR)/external/com_google_protobuf/src",
        "/Iexternal/darts_clone",
    ],
    includes = ["src", "."],
    deps = [
        ":sentencepiece_cc_proto",
        ":sentencepiece_model_cc_proto",
        "@com_google_absl//absl/base:core_headers",
        "@com_google_absl//absl/cleanup",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/container:flat_hash_set",
        "@com_google_absl//absl/strings:str_format",
        "@darts_clone//:darts_clone",
    ],
)
